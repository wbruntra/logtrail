{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": "./",
    "removeComments": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["bun"],
    "paths": {
      "@/*": ["./*"],
      "@database/*": ["./database/*"],
      "@hono-app/*": ["./hono-app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.js", "ecosystem.config.cjs"],
  "exclude": ["node_modules", "dist", "client", "preact-client"]
}
